  "title": "Stop spaceship specs sharing clients and cached state",
  "user": {
    "login": "lacostej",
    "id": 24282,
    "node_id": "MDQ6VXNlcjI0Mjgy",
    "avatar_url": "https://avatars.githubusercontent.com/u/24282?v=4",
    "gravatar_id": "",
